# 🤖 AI Code Review Enhanced
#
# Versão melhorada do code review bot com análise mais inteligente
# Para usar:
# 1. Renomeie para ai-code-review-enhanced.yml
# 2. Configure OPENAI_API_KEY em Secrets (opcional)
# 3. Ou use apenas análise baseada em regras (sem IA)

name: AI Code Review Enhanced

on:
  pull_request:
    types: [opened, synchronize, reopened, ready_for_review]
    branches:
      - develop
      - master

jobs:
  ai-review:
    name: 🤖 AI Code Review
    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: write
      issues: write
    steps:
      - name: Checkout code
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: AI Code Review Analysis
        uses: actions/github-script@v7
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          # Opcional: Se tiver OpenAI API key
          # OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
        with:
          script: |
            const { data: files } = await github.rest.pulls.listFiles({
              owner: context.repo.owner,
              repo: context.repo.repo,
              pull_number: context.issue.number,
            });

            const kotlinFiles = files.filter(file =>
              file.filename.endsWith('.kt') &&
              file.status !== 'removed' &&
              file.status !== 'deleted'
            );

            if (kotlinFiles.length === 0) {
              await github.rest.issues.createComment({
                owner: context.repo.owner,
                repo: context.repo.repo,
                issue_number: context.issue.number,
                body: '✅ **AI Code Review**: Nenhum arquivo Kotlin modificado.'
              });
              return;
            }

            let reviewComments = [];
            let securityIssues = [];
            let performanceIssues = [];
            let codeQualityIssues = [];

            for (const file of kotlinFiles) {
              try {
                const { data: content } = await github.rest.repos.getContent({
                  owner: context.repo.owner,
                  repo: context.repo.repo,
                  path: file.filename,
                  ref: context.payload.pull_request.head.sha,
                });

                const fileContent = Buffer.from(content.content, 'base64').toString();
                const lines = fileContent.split('\n');

                // Análise de Segurança
                if (fileContent.includes('password') || fileContent.includes('secret') || fileContent.includes('api_key')) {
                  if (!fileContent.includes('@Suppress') && !fileContent.includes('')) {
                    securityIssues.push({
                      file: file.filename,
                      issue: '🔒 Possível exposição de credenciais. Considere usar variáveis de ambiente ou secrets.'
                    });
                  }
                }

                // Verificar uso de funções inseguras
                const insecurePatterns = [
                  /Runtime\.getRuntime\(\)/,
                  /ProcessBuilder/,
                  /eval\(/,
                  /exec\(/
                ];

                insecurePatterns.forEach(pattern => {
                  if (pattern.test(fileContent)) {
                    securityIssues.push({
                      file: file.filename,
                      issue: '🔒 Uso de funções potencialmente inseguras detectado.'
                    });
                  }
                });

                // Análise de Performance
                if (fileContent.includes('for (') && fileContent.includes('for (')) {
                  // Verificar loops aninhados
                  const nestedLoops = (fileContent.match(/for\s*\(/g) || []).length;
                  if (nestedLoops > 2) {
                    performanceIssues.push({
                      file: file.filename,
                      issue: '⚡ Múltiplos loops aninhados podem impactar performance. Considere otimizar.'
                    });
                  }
                }

                // Verificar uso de String concatenation em loops
                if (fileContent.includes('for (') && fileContent.includes('+=')) {
                  performanceIssues.push({
                    file: file.filename,
                    issue: '⚡ Concatenação de String em loop. Considere usar StringBuilder ou string templates.'
                  });
                }

                // Análise de Qualidade de Código
                const longMethods = [];
                lines.forEach((line, index) => {
                  if (line.trim().startsWith('fun ')) {
                    let functionLines = 0;
                    let braceCount = 0;
                    let inFunction = false;

                    for (let i = index; i < lines.length; i++) {
                      const currentLine = lines[i];
                      braceCount += (currentLine.match(/{/g) || []).length;
                      braceCount -= (currentLine.match(/}/g) || []).length;

                      if (braceCount > 0) inFunction = true;
                      if (inFunction) functionLines++;
                      if (inFunction && braceCount === 0) break;
                    }

                    if (functionLines > 50) {
                      longMethods.push({
                        file: file.filename,
                        line: index + 1,
                        lines: functionLines
                      });
                    }
                  }
                });

                if (longMethods.length > 0) {
                  codeQualityIssues.push({
                    file: file.filename,
                    issue: `📏 Funções muito longas encontradas (${longMethods.length}). Considere dividir em funções menores.`
                  });
                }

                // Verificar uso de var em vez de val quando possível
                const varUsage = (fileContent.match(/\bvar\s+\w+/g) || []).length;
                const valUsage = (fileContent.match(/\bval\s+\w+/g) || []).length;
                if (varUsage > valUsage * 0.3) {
                  codeQualityIssues.push({
                    file: file.filename,
                    issue: '💡 Considere usar `val` em vez de `var` quando possível para imutabilidade.'
                  });
                }

              } catch (error) {
                console.log(`Erro ao analisar ${file.filename}: ${error.message}`);
              }
            }

            // Criar comentário consolidado
            let commentBody = '## 🤖 AI Code Review Enhanced\n\n';

            const totalIssues = securityIssues.length + performanceIssues.length + codeQualityIssues.length;

            if (totalIssues === 0) {
              commentBody += '✅ **Excelente trabalho!** Nenhum problema encontrado.\n\n';
            } else {
              commentBody += `📊 **Resumo da Análise:**\n`;
              commentBody += `- Arquivos analisados: ${kotlinFiles.length}\n`;
              commentBody += `- Problemas de segurança: ${securityIssues.length}\n`;
              commentBody += `- Problemas de performance: ${performanceIssues.length}\n`;
              commentBody += `- Problemas de qualidade: ${codeQualityIssues.length}\n\n`;
              commentBody += '---\n\n';

              if (securityIssues.length > 0) {
                commentBody += '### 🔒 Problemas de Segurança\n\n';
                securityIssues.forEach(issue => {
                  commentBody += `**${issue.file}:**\n`;
                  commentBody += `- ${issue.issue}\n\n`;
                });
                commentBody += '---\n\n';
              }

              if (performanceIssues.length > 0) {
                commentBody += '### ⚡ Problemas de Performance\n\n';
                performanceIssues.forEach(issue => {
                  commentBody += `**${issue.file}:**\n`;
                  commentBody += `- ${issue.issue}\n\n`;
                });
                commentBody += '---\n\n';
              }

              if (codeQualityIssues.length > 0) {
                commentBody += '### 📏 Problemas de Qualidade\n\n';
                codeQualityIssues.forEach(issue => {
                  commentBody += `**${issue.file}:**\n`;
                  commentBody += `- ${issue.issue}\n\n`;
                });
              }
            }

            commentBody += '\n> 💡 Este é um review automatizado com análise avançada.';

            await github.rest.issues.createComment({
              owner: context.repo.owner,
              repo: context.repo.repo,
              issue_number: context.issue.number,
              body: commentBody
            });

            // Criar review
            if (totalIssues > 0) {
              const reviewEvent = securityIssues.length > 0 ? 'REQUEST_CHANGES' : 'COMMENT';

              await github.rest.pulls.createReview({
                owner: context.repo.owner,
                repo: context.repo.repo,
                pull_number: context.issue.number,
                event: reviewEvent,
                body: `🤖 **AI Code Review Enhanced**\n\n` +
                      `Foram encontrados ${totalIssues} pontos de atenção.\n\n` +
                      `Por favor, revise os comentários acima.`
              });
            } else {
              await github.rest.pulls.createReview({
                owner: context.repo.owner,
                repo: context.repo.repo,
                pull_number: context.issue.number,
                event: 'APPROVE',
                body: '✅ **AI Code Review Enhanced**: Código aprovado! Nenhum problema encontrado.'
              });
            }

